---
import { getCollection } from "astro:content";

interface Props {
    currentProject?: string | null;
}

const { currentProject = null } = Astro.props;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

{
    /*
    Uses the same nav-group-toggle / nav-group-menu pair as every other dropdown,
    so NavHeader's single delegated handler drives it. It previously had its own
    ids and its own handler, which is how it broke: the nav's script was
    rewritten and only the other mechanism got carried across.
*/
}
<li class="group relative">
    <button
        type="button"
        class="nav-group-toggle cursor-pointer rounded px-2 py-1 transition-colors"
        aria-expanded="false"
        aria-haspopup="true">
        Projects
    </button>
    <ul
        class="nav-group-menu invisible absolute top-full left-0 z-10 min-w-[180px] rounded border py-2 shadow-lg">
        {
            projects.map((project) => (
                <li>
                    <a
                        href={`/${project.id}`}
                        class={`block px-4 py-2 whitespace-nowrap transition-colors ${project.id === currentProject ? "font-bold" : ""}`}>
                        {project.data.title}
                    </a>
                </li>
            ))
        }
    </ul>
</li>
