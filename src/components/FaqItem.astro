---
/*
 * One collapsed question. Split out of FaqList so a page written in MDX can
 * use the same accordion with real markdown inside it - lists, links and
 * several paragraphs - rather than an HTML string in a prop.
 *
 * SmoothScroll opens the ancestors of an anchor target, so a link to a heading
 * inside one of these still lands on it.
 */

interface Props {
    q: string;
}

const { q } = Astro.props as Props;
---

{
    /* not-prose on the summary: inside an article the prose styles give it the
    margins of the heading it looks like, which leaves the collapsed row several
    times taller than the text in it. */
}
<details class="faq-item not-prose my-3 rounded-lg border p-4">
    <summary class="cursor-pointer font-semibold">{q}</summary>
    <div class="mt-3 max-w-prose space-y-3 [&_a]:underline [&_ul]:ml-5 [&_ul]:list-disc">
        <slot />
    </div>
</details>

<style>
    /* Derived from the surrounding Block's surface rather than a fixed palette,
       so the same component works on every product's chosen colours. */
    .faq-item {
        border-color: color-mix(in srgb, currentColor 20%, transparent);
        background-color: color-mix(in srgb, currentColor 6%, transparent);
    }
</style>
