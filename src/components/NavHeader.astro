---
import ProjectSelector from "./ProjectSelector.astro";
import ThemeSelector from "./ThemeSelector.astro";
import { buildNav, isGroup, type NavItem } from "../nav";
import { getCollection } from "astro:content";

interface Props {
    currentProject?: string | null;
    /** Starlight routes pass this; the manual search button renders into it. */
    search?: boolean;
    /** Starlight's own .header is already position:fixed, so nav must not stack another. */
    position?: "sticky" | "static";
}

const { currentProject = null, search = false, position = "sticky" } = Astro.props as Props;

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const currentProjectData = projects.find((p) => p.id === currentProject);
const nav = await buildNav(currentProject);

const flat = [...nav.items.filter((entry): entry is NavItem => !isGroup(entry)), ...nav.trailing];
---

<nav
    id="nav"
    class:list={[
        position === "sticky" && "sticky top-0",
        "z-50 font-semibold shadow-xl backdrop-blur-lg select-none print:hidden",
    ]}>
    <div class="relative flex h-[var(--nav-height)] items-center gap-3 px-3">
        <a href="/" title="surge-synth-team.org" class="shrink-0">
            <img
                src="/images/sst-logo.svg"
                alt="Surge Synth Team logo"
                loading="lazy"
                decoding="async"
                width="24"
                height="24"
                class="m-0 min-h-[24px] min-w-[24px] p-0"
            />
        </a>

        <button
            id="nav-hamburger"
            class="absolute left-1/2 flex -translate-x-1/2 flex-col gap-[3px] p-1 md:hidden"
            aria-label="Toggle menu"
            aria-expanded="false">
            <span class="nav-bar block h-0.5 w-5"></span>
            <span class="nav-bar block h-0.5 w-5"></span>
            <span class="nav-bar block h-0.5 w-5"></span>
        </button>
        <div class="hidden md:flex md:flex-1 md:items-center md:gap-3">
            <menu class="flex shrink-0 items-center">
                <ProjectSelector currentProject={currentProject} />
            </menu>

            <div class="nav-divider h-5 w-px shrink-0"></div>

            <menu class="flex shrink-0 flex-row items-center gap-2">
                {
                    currentProjectData && (
                        <li>
                            <a
                                href={`/${currentProject}`}
                                class="rounded px-2 py-1 font-bold whitespace-nowrap transition-colors">
                                {currentProjectData.data.title}
                            </a>
                        </li>
                    )
                }

                {
                    nav.items.map((entry) =>
                        !isGroup(entry) ? (
                            <li>
                                <a
                                    class="rounded px-2 py-1 whitespace-nowrap transition-colors"
                                    href={entry.href}>
                                    {entry.label}
                                </a>
                            </li>
                        ) : (
                            <li class="group relative">
                                <button
                                    type="button"
                                    class="nav-group-toggle cursor-pointer rounded px-2 py-1 whitespace-nowrap transition-colors"
                                    aria-expanded="false"
                                    aria-haspopup="true">
                                    {entry.label}
                                </button>
                                <ul class="nav-group-menu absolute top-full left-0 z-10 min-w-[180px] rounded border-2 py-2 shadow-lg">
                                    {entry.items.map((item) => (
                                        <li>
                                            <a
                                                href={item.href}
                                                class="block px-4 py-2 whitespace-nowrap transition-colors">
                                                {item.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </li>
                        ),
                    )
                }

                {
                    nav.trailing.map((item) => (
                        <li>
                            <a
                                class="rounded px-2 py-1 whitespace-nowrap transition-colors"
                                href={item.href}>
                                {item.label}
                            </a>
                        </li>
                    ))
                }
            </menu>
        </div>

        <div class="ml-auto flex shrink-0 items-center gap-3">
            {search && <slot name="search" />}
            <div class="nav-divider h-5 w-px"></div>
            <ThemeSelector />
        </div>
    </div>

    <div
        id="nav-mobile-menu"
        class="nav-divider-top hidden flex-col gap-1 border-t px-3 py-2 md:hidden">
        <div class="flex flex-col">
            <button
                id="mobile-projects-toggle"
                class="nav-mobile-item flex items-center justify-between rounded px-2 py-1 transition-colors"
                aria-expanded="false">
                <span>Projects</span>
                <span id="mobile-projects-chevron" class="transition-transform">▾</span>
            </button>
            <div id="mobile-projects-list" class="hidden flex-col pl-4">
                {
                    projects.map((project) => (
                        <a
                            href={`/${project.id}`}
                            class={`nav-mobile-item rounded px-2 py-1 transition-colors ${project.id === currentProject ? "font-bold" : ""}`}>
                            {project.data.title}
                        </a>
                    ))
                }
            </div>
        </div>

        {
            currentProjectData && (
                <>
                    <div class="nav-divider h-px" />
                    <a
                        href={`/${currentProject}`}
                        class="nav-mobile-item rounded px-2 py-1 font-bold transition-colors">
                        {currentProjectData.data.title}
                    </a>
                </>
            )
        }

        {
            nav.items.filter(isGroup).map((group) => (
                <div class="flex flex-col">
                    <button
                        class="mobile-group-toggle nav-mobile-item flex items-center justify-between rounded px-2 py-1 transition-colors"
                        aria-expanded="false">
                        <span>{group.label}</span>
                        <span class="transition-transform">▾</span>
                    </button>
                    <div class="mobile-group-list hidden flex-col pl-4">
                        {group.items.map((item) => (
                            <a
                                href={item.href}
                                class="nav-mobile-item rounded px-2 py-1 transition-colors">
                                {item.label}
                            </a>
                        ))}
                    </div>
                </div>
            ))
        }

        {
            flat.map((item) => (
                <a class="nav-mobile-item rounded px-2 py-1 transition-colors" href={item.href}>
                    {item.label}
                </a>
            ))
        }
    </div>
</nav>

<script>
    function init() {
        const hamburger = document.getElementById("nav-hamburger");
        const menu = document.getElementById("nav-mobile-menu");

        if (hamburger && menu) {
            hamburger.addEventListener("click", () => {
                const open = menu.classList.toggle("flex");
                menu.classList.toggle("hidden", !open);
                hamburger.setAttribute("aria-expanded", String(open));
            });
        }

        function wireDisclosure(toggle: HTMLElement, list: HTMLElement) {
            toggle.addEventListener("click", () => {
                const open = list.classList.toggle("flex");
                list.classList.toggle("hidden", !open);
                toggle.setAttribute("aria-expanded", String(open));

                const chevron = toggle.querySelector("span:last-child") as HTMLElement | null;
                if (chevron) chevron.style.transform = open ? "rotate(180deg)" : "";
            });
        }

        const projectsToggle = document.getElementById("mobile-projects-toggle");
        const projectsList = document.getElementById("mobile-projects-list");
        if (projectsToggle && projectsList) wireDisclosure(projectsToggle, projectsList);

        document.querySelectorAll<HTMLElement>(".mobile-group-toggle").forEach((toggle) => {
            const list = toggle.nextElementSibling as HTMLElement | null;
            if (list) wireDisclosure(toggle, list);
        });

        /*
         * Desktop dropdowns. A pointer that can hover opens them on hover, in
         * CSS - see nav.css. This handles the rest: a tap on a touch screen,
         * where there is no hover to open with, and the keyboard.
         *
         * aria-expanded is the state, and the stylesheet reads it. Toggling a
         * `invisible` utility instead would put the open state in Tailwind's
         * utilities layer, which outranks every layer a hover rule could live
         * in - so hover could never show a menu the class had hidden.
         */
        const groups = Array.from(document.querySelectorAll<HTMLElement>(".nav-group-toggle"));

        function closeAll(except?: HTMLElement) {
            for (const toggle of groups) {
                if (toggle === except) continue;
                toggle.setAttribute("aria-expanded", "false");
            }
        }

        for (const toggle of groups) {
            const list = toggle.nextElementSibling as HTMLElement | null;
            if (!list) continue;

            toggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const open = toggle.getAttribute("aria-expanded") === "true";
                toggle.setAttribute("aria-expanded", String(!open));
                closeAll(toggle);
            });

            toggle.addEventListener("keydown", (e) => {
                if (e.key !== "ArrowDown") return;
                e.preventDefault();
                toggle.setAttribute("aria-expanded", "true");
                list.querySelector("a")?.focus();
            });
        }

        document.addEventListener("click", () => closeAll());

        document.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            const open = groups.find((t) => t.getAttribute("aria-expanded") === "true");
            closeAll();
            open?.focus();
        });
    }

    document.addEventListener("astro:after-swap", init);
    init();
</script>
