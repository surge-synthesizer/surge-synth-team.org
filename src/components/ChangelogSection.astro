---
type CommitEntry = {
    author: string;
    commit: string;
    date: string;
    message: string;
};

type NightlyBuildData = {
    build_time: string;
    latest_commit: string;
    recent_commits: CommitEntry[];
    releases: {
        other: string;
    };
};

/*
 * A payload: it renders content, not a band. The enclosing Block owns the
 * surface, the width and the vertical rhythm.
 *
 * Currently unused. It renders build activity from the generated release data,
 * which belongs on a nightlies page next to the builds themselves — as it does
 * on the Surge site — rather than on a product page or among written release
 * notes. Kept for that page.
 */
interface Props {
    productName: string;
    nightly: NightlyBuildData;
}

const { productName, nightly } = Astro.props as Props;

const latestBuildTime = new Date(nightly.build_time);
const changelogBuildDate = Number.isNaN(latestBuildTime.getTime())
    ? null
    : latestBuildTime.toLocaleDateString("en-US", {
          year: "numeric",
          month: "short",
          day: "numeric",
      });
---

<div>
    <h2 class="text-2xl font-bold">Changelog</h2>
    <p class="mt-2 max-w-prose">
        Latest nightly build updates for {productName}.
        {changelogBuildDate && ` Last build: ${changelogBuildDate}.`}
    </p>
    <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="font-semibold">Latest commit: {nightly.latest_commit}</span>
        <a href={nightly.releases.other} class="underline underline-offset-2">
            Full release notes
        </a>
    </div>
    <ul class="mt-4 divide-y divide-current/20">
        {
            nightly.recent_commits.map((entry) => (
                <li class="py-4">
                    <p class="font-semibold">{entry.message}</p>
                    <p class="mt-1 text-xs">
                        {entry.author} · {entry.commit} ·{" "}
                        {new Date(entry.date).toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "short",
                            day: "numeric",
                        })}
                    </p>
                </li>
            ))
        }
    </ul>
</div>
