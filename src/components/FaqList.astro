---
/*
 * A heading and a stack of questions, for the FAQ band on a product page.
 *
 * Answers are authored HTML, not user input - several carry <code> and links -
 * so they are rendered with set:html rather than as text. A page with longer
 * answers uses FaqItem directly from MDX instead.
 */

import FaqItem from "./FaqItem.astro";

interface Props {
    heading?: string;
    items: ReadonlyArray<{ q: string; a: string }>;
}

const { heading = "FAQ", items } = Astro.props as Props;
---

<div>
    <h2 class="text-2xl font-bold">{heading}</h2>
    <div class="mt-6">
        {
            items.map((item) => (
                <FaqItem q={item.q}>
                    <Fragment set:html={item.a} />
                </FaqItem>
            ))
        }
    </div>
</div>
