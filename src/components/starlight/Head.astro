---
/*
 * Adds the view-transition router to manual pages.
 *
 * Base.astro has carried <ClientRouter /> all along, so product pages
 * cross-faded between each other while any navigation into or out of a manual
 * was a hard load — the inconsistency being that manuals are the same site.
 *
 * Starlight is not itself view-transition aware, but its interactive parts are
 * custom elements, which re-run connectedCallback when the swapped-in nodes are
 * inserted. Our own nav, theme and sidebar scripts listen for astro:after-swap.
 */

import Default from "@astrojs/starlight/components/Head.astro";
import { ClientRouter } from "astro:transitions";
import SmoothScroll from "../SmoothScroll.astro";

/*
 * A nightly manual is linked on purpose — unreleased documentation has to be
 * reviewable in place — but it must never outrank the released manual in a
 * search engine.
 */
const nightly = Astro.locals.starlightRoute.entry.id.includes("/manual-nightly/");
---

<Default />
<ClientRouter />
<SmoothScroll />
{nightly && <meta name="robots" content="noindex, follow" />}
