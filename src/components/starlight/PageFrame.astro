---
/*
 * Vendored from @astrojs/starlight 0.42.0 components/PageFrame.astro.
 *
 * Four changes against upstream, each marked SST below:
 *   1. a display:contents wrapper carrying data-project, because Starlight
 *      computes the <html> data attributes in Page.astro, which is not an
 *      overridable component — this is the closest server-rendered hook to the
 *      document root, so there is no theme flash and no JavaScript involved
 *   2. .header height goes from fixed to a minimum, so the site nav's mobile
 *      menu can expand inside it instead of being clipped
 *   3. MobileMenuToggle (fixed, top right) is dropped — it collided with the
 *      site nav's own hamburger in that same corner
 *   4. a bottom-left rail that collapses the sidebar on desktop and opens the
 *      popover pane on mobile; see src/layouts/starlight.css
 *
 * On a Starlight upgrade, re-copy the file and re-apply those four.
 */

const { hasSidebar, entry } = Astro.locals.starlightRoute;

// SST (1 of 4)
const product = entry.id.split('/')[0];
---

<div data-project={product} style="display: contents">
<div class="page sl-flex">
	<header class="header"><slot name="header" /></header>
	{
		hasSidebar && (
			<nav class="sidebar print:hidden" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
				{/* SST (3 and 4 of 4): upstream renders <MobileMenuToggle /> here, fixed to the
				    top-right corner the site nav's hamburger already occupies. This replaces it.
				    popovertarget drives the mobile pane with no JavaScript; the desktop collapse
				    is layered on top by the script below. */}
				<div class="sidebar-rail">
					<button
						type="button"
						popovertarget="starlight__sidebar"
						aria-controls="starlight__sidebar"
						data-sidebar-toggle>
						{/* A side-panel glyph rather than a bare chevron, so the control says
						    what it acts on. Two variants, swapped by CSS on the collapsed
						    state, so the arrow always points where the click will take you. */}
						<svg
							class="icon icon-collapse"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="2" />
							<path d="M9 3v18" />
							<path d="M16 15l-3-3 3-3" />
						</svg>
						<svg
							class="icon icon-expand"
							width="16"
							height="16"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="2" />
							<path d="M9 3v18" />
							<path d="M14 9l3 3-3 3" />
						</svg>
						<span class="label">Contents</span>
					</button>
				</div>
				<script>
					// Desktop only: the pane is a popover below 50rem, where there is nothing to
					// collapse and popovertarget already does the work. The attribute is set on
					// <html> because --sl-sidebar-width has to be read by Page.astro's rule.
					const KEY = 'sidebar';
					const desktop = matchMedia('(min-width: 50rem)');

					function applyStored() {
						try {
							const collapsed = localStorage.getItem(KEY) === 'collapsed';
							document.documentElement.dataset.sidebar = collapsed ? 'collapsed' : 'expanded';
						} catch {
							document.documentElement.dataset.sidebar = 'expanded';
						}
					}

					function init() {
						applyStored();

						document
							.querySelectorAll<HTMLButtonElement>('[data-sidebar-toggle]')
							.forEach((button) => {
								button.addEventListener('click', (event) => {
									if (!desktop.matches) return;

									// popovertarget is what drives the pane on mobile with no
									// JavaScript, but it fires on desktop too: the pane would open
									// into the top layer, which outranks any z-index, and paint
									// over this very button. Opening the popover is the click's
									// activation behaviour, so cancelling the event suppresses it
									// — leaving the collapse below as the only effect.
									event.preventDefault();

									const collapsed =
										document.documentElement.dataset.sidebar === 'collapsed';
									const next = collapsed ? 'expanded' : 'collapsed';

									document.documentElement.dataset.sidebar = next;
									button.setAttribute('aria-expanded', String(collapsed));

									try {
										localStorage.setItem(KEY, next);
									} catch {
										// Private browsing; the choice simply does not persist.
									}
								});
							});
					}

					document.addEventListener('astro:after-swap', init);
					init();
				</script>
				<script>
					// The mobile menu uses the popover API to open and close without JavaScript. We enhance this
					// behaviour with focus trapping while the menu is open.
					class StarlightSidebarPane extends HTMLElement {
						constructor() {
							super();

							// Close the menu when the viewport is resized between mobile and desktop sizes.
							matchMedia('(min-width: 50em)').addEventListener('change', () => this.hidePopover());

							// Update the menu state when the sidebar popover is toggled.
							this.addEventListener('toggle', ({ newState }) => this.trapFocus(newState === 'open'));
						}
						/** Trap keyboard focus inside the header and menu when the menu is expanded. */
						trapFocus(shouldTrap: boolean) {
							document.querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link').forEach((el) => {
								el.toggleAttribute('inert', shouldTrap);
							});
						}
					}
					customElements.define('sl-sidebar-pane', StarlightSidebarPane);
				</script>
				<sl-sidebar-pane popover="" id="starlight__sidebar" class="sidebar-pane">
					<div class="sidebar-content sl-flex">
						<slot name="sidebar" />
					</div>
				</sl-sidebar-pane>
			</nav>
		)
	}
	<div class="main-frame"><slot /></div>
</div>
</div>

<style>
	@layer starlight.core {
		.page {
			flex-direction: column;
			min-height: 100vh;
		}

		.header {
			z-index: var(--sl-z-index-navbar);
			position: fixed;
			inset-inline-start: 0;
			inset-block-start: 0;
			width: 100%;
			/* SST (2 of 4): upstream fixes this at var(--sl-nav-height). The site
			   nav expands in place on mobile when its menu opens, which a fixed
			   height would clip. The minimum keeps .main-frame's padding correct,
			   since the expanded menu overlays rather than displaces. */
			min-height: var(--sl-nav-height);
			border-bottom: 1px solid var(--sl-color-hairline-shade);
			background-color: var(--sl-color-bg-nav);
		}

		.sidebar-pane {
			/* By default, user agents apply some opinionated styles to popovers, which we don’t want. */
			border: unset;
			padding: unset;
			height: unset;
			color: unset;

			position: fixed;
			z-index: var(--sl-z-index-menu);
			inset-block: var(--sl-nav-height) 0;
			inset-inline-start: 0;
			width: 100%;
			background-color: var(--sl-color-black);
			overflow-y: auto;
			scrollbar-gutter: stable;
		}

		.sidebar-content {
			height: 100%;
			min-height: max-content;
			padding: 1rem var(--sl-sidebar-pad-x) 0;
			flex-direction: column;
			gap: 1rem;
		}

		@media (min-width: 50rem) {
			.sidebar-content::after {
				content: '';
				padding-bottom: 1px;
			}
		}

		.main-frame {
			padding-top: calc(var(--sl-nav-height) + var(--sl-mobile-toc-height));
			padding-inline-start: var(--sl-content-inline-start);
		}

		@media (min-width: 50rem) {
			/* SST: upstream reserves header padding here for the menu button that
			   change 3 removed. The nav supplies its own padding. */
			.sidebar-pane {
				/* Make the sidebar visible on larger screens instead of deferring to popover state. */
				display: block;
				width: var(--sl-sidebar-width);
				background-color: var(--sl-color-bg-sidebar);
				border-inline-end: 1px solid var(--sl-color-hairline-shade);
			}
		}
	}
</style>
