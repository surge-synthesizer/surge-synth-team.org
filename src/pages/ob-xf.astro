---
import { Image } from "astro:assets";
import obxf_build_stable from "../content/generated/obxf-build-stable.json" with { type: "json" };
import obxf_build_nightly from "../content/generated/obxf-build-nightly.json" with { type: "json" };
import Block from "../components/Block.astro";
import Button from "../components/Button.astro";
import Cell from "../components/Cell.astro";
import DownloadButton from "../components/DownloadButton.astro";
import DownloadMatrix from "../components/DownloadMatrix.astro";
import NavHeader from "../components/NavHeader.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import ObxfCover from "../content/projects/screenshots/ob-xf_3d_render.png";
import Base from "../layouts/Base.astro";

const platformLinks = (releases: { win64: string; macos: string; linux64: string }) => [
    { label: "Windows 64-bit", href: releases.win64 },
    { label: "macOS 64-bit", href: releases.macos },
    { label: "Linux 64-bit", href: releases.linux64 },
];

const systemRequirements = [
    {
        name: "Windows",
        items: [
            "Windows 10 or above",
            "Recommended: Windows 10 or newer, 3 GHz quad-core processor",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
    {
        name: "macOS",
        items: [
            "macOS 10.15 or above",
            "8 GB RAM or above",
            "VST3, AU or CLAP compatible host application",
        ],
    },
    {
        name: "Linux",
        items: [
            "PC or ARM system running a Linux distribution",
            "8 GB RAM or above",
            "VST3, CLAP or LV2 compatible host application",
        ],
    },
];
---

<Base title="OB-Xf" project="ob-xf">
    <NavHeader slot="nav" currentProject="ob-xf" />

    <main>
        <Block surface="base" layout="split" class="md:min-h-[500px]">
            <Cell>
                <img
                    src="/images/obxf_logo.svg"
                    alt="OB-Xf logo"
                    class="invert-in-light h-20 w-auto self-start md:h-28"
                />
                <p class="mt-4 max-w-prose">
                    OB-Xf is a continuation and modernization of the last open source release of
                    OB-Xd. It is inspired by the venerable Oberheim OB-X.
                </p>
                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <DownloadButton
                        windows={obxf_build_stable.releases.win64}
                        mac={obxf_build_stable.releases.macos}
                        linux={obxf_build_stable.releases.linux64}
                        other={obxf_build_stable.releases.other}
                        label={`Download ${obxf_build_stable.version}`}
                        id="obxf-release-link"
                        buttonClass="button button-solid"
                    />
                    <Button href="https://github.com/surge-synthesizer/OB-Xf">View on GitHub</Button
                    >
                </div>
                <p class="mt-4">
                    <a href={obxf_build_stable.releases.other}>Install for other platforms</a>
                </p>
            </Cell>

            <Cell padded={false} class="min-h-[250px] md:min-h-0">
                <Image
                    src={ObxfCover}
                    alt="OB-Xf interface screenshot"
                    quality="100"
                    format="png"
                    class="h-full max-h-[400px] w-full object-contain"
                />
            </Cell>
        </Block>

        <Block id="manual" surface="raised" layout="prose">
            <h2 class="text-2xl font-bold">Manual</h2>
            <p class="mt-2 max-w-prose">
                The OB-Xf manual is available as dedicated docs powered by Astro Starlight.
            </p>
            <Button class="mt-6" href="/ob-xf/manual/getting-started/">Open Manual</Button>
        </Block>

        <Block id="downloads" surface="slate" layout="split">
            <Cell align="start">
                <SystemRequirements platforms={systemRequirements} />
            </Cell>

            <Cell align="start">
                <DownloadMatrix
                    heading="Download OB-Xf"
                    channels={[
                        {
                            label: `Version ${obxf_build_stable.version}`,
                            links: platformLinks(obxf_build_stable.releases),
                            all: {
                                label: "All available downloads",
                                href: obxf_build_stable.releases.other,
                            },
                        },
                        {
                            label: "Nightly Builds",
                            links: platformLinks(obxf_build_nightly.releases),
                            all: {
                                label: "All available nightly downloads",
                                href: obxf_build_nightly.releases.other,
                            },
                        },
                    ]}
                />
            </Cell>
        </Block>
    </main>

    <Block as="footer" surface="ink" layout="prose" class="text-center">
        This project is maintained by the community at the
        <a href="https://github.com/surge-synthesizer/OB-Xf" target="_blank" rel="noopener">OB-Xf</a
        >
        open source project on GitHub.
    </Block>
</Base>
