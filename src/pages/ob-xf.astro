---
import { Image } from "astro:assets";
import obxf_build_stable from "../content/generated/obxf-build-stable.json" with { type: "json" };
import obxf_build_nightly from "../content/generated/obxf-build-nightly.json" with { type: "json" };
import Block from "../components/Block.astro";
import Button from "../components/Button.astro";
import Cell from "../components/Cell.astro";
import DownloadButton from "../components/DownloadButton.astro";
import DownloadMatrix from "../components/DownloadMatrix.astro";
import NavHeader from "../components/NavHeader.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import ObxfHero from "../content/products/ob-xf/images/ob-xf-hero.png";
import Base from "../layouts/Base.astro";
import { version } from "../version";
import SiteFooter from "../components/SiteFooter.astro";

const platformLinks = (releases: { win64: string; macos: string; linux64: string }) => [
    { label: "Windows 64-bit", href: releases.win64 },
    { label: "macOS 64-bit", href: releases.macos },
    { label: "Linux 64-bit", href: releases.linux64 },
];

const systemRequirements = [
    {
        name: "Windows",
        items: [
            "Windows 10 or above",
            "Recommended: Windows 10 or newer, 3 GHz quad-core processor",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
    {
        name: "macOS",
        items: [
            "macOS 10.15 or above",
            "8 GB RAM or above",
            "VST3, AU or CLAP compatible host application",
        ],
    },
    {
        name: "Linux",
        items: [
            "PC or ARM system running a Linux distribution",
            "8 GB RAM or above",
            "VST3, CLAP or LV2 compatible host application",
        ],
    },
];
---

<Base title="OB-Xf" project="ob-xf">
    <NavHeader slot="nav" currentProject="ob-xf" />

    <main>
        <Block surface="base" layout="split" class="overflow-hidden">
            <Cell align="start">
                {
                    /* 80% of the column, not the full width the Surge XT mark
                       takes: this one is 2.97:1 against that one's 3.72:1, so at
                       equal widths it would stand half again as tall. Scaled by the
                       difference, the two heroes carry a mark of the same height at
                       every width. */
                }
                <h1>
                    <img
                        src="/images/obxf_logo.svg"
                        alt="OB-Xf"
                        class="invert-in-light h-auto w-[80%] max-w-[532px]"
                    />
                </h1>
                <p class="mt-4 max-w-prose">
                    OB-Xf is a continuation and modernization of the last open source release of
                    OB-Xd. It is inspired by the venerable Oberheim OB-X.
                </p>
                <div class="flex flex-wrap items-center gap-3">
                    <DownloadButton
                        windows={obxf_build_stable.releases.win64}
                        mac={obxf_build_stable.releases.macos}
                        linux={obxf_build_stable.releases.linux64}
                        other={obxf_build_stable.releases.other}
                        id="obxf-release-link"
                        buttonClass="button button-solid"
                    />
                </div>
                <p class="mt-4">
                    <a href={obxf_build_stable.releases.other}>
                        Downloads for other platforms and installers
                    </a>
                </p>
                <p>
                    <a href="/ob-xf/changelog/">
                        What's new in OB-Xf {version(obxf_build_stable.version)}?
                    </a>
                </p>
                <p><a href="/ob-xf/manual/">Read the manual</a></p>
            </Cell>

            {
                /* Sized by height and anchored left, so the panel is never cut
                   across the top or bottom - only the far edge runs past the
                   column, and the band clips it.

                   Height is pinned below about 1950px, which is what holds the
                   image steady while the window narrows, the way the Surge XT hero
                   does; above that it tracks the viewport so the image stays wider
                   than its column and keeps bleeding rather than leaving a gap.

                   Stacked below the copy on a narrow window it is centred instead:
                   there is no column for it to run out of, so anchoring it left
                   would just park the overhang on one side. */
            }
            <Cell padded={false} class="py-8">
                <Image
                    src={ObxfHero}
                    alt="The OB-Xf interface"
                    quality="100"
                    class="h-[220px] w-auto max-w-none self-center md:h-[max(600px,31vw)] md:self-start"
                />
            </Cell>
        </Block>

        <Block id="manual" surface="raised" layout="prose">
            <h2>Manual</h2>
            <p class="max-w-prose">
                The OB-Xf manual is available as dedicated docs powered by Astro Starlight.
            </p>
            <Button class="mt-6" href="/ob-xf/manual/getting-started/">Open Manual</Button>
        </Block>

        <Block id="downloads" surface="walnut" layout="split">
            <Cell align="start">
                <SystemRequirements platforms={systemRequirements} />
            </Cell>

            <Cell align="start">
                <DownloadMatrix
                    heading="Download OB-Xf"
                    channels={[
                        {
                            label: `Version ${version(obxf_build_stable.version)}`,
                            links: platformLinks(obxf_build_stable.releases),
                            all: {
                                label: "All available downloads",
                                href: obxf_build_stable.releases.other,
                            },
                        },
                        {
                            label: "Nightly Builds",
                            links: platformLinks(obxf_build_nightly.releases),
                            all: {
                                label: "All available nightly downloads",
                                href: obxf_build_nightly.releases.other,
                            },
                        },
                    ]}
                />
            </Cell>
        </Block>
    </main>

    <SiteFooter />
</Base>
