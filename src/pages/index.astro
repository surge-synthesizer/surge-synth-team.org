---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Block from "../components/Block.astro";
import Button from "../components/Button.astro";
import Cell from "../components/Cell.astro";
import NavHeader from "../components/NavHeader.astro";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Home">
    <NavHeader slot="nav" />

    <main>
        {
            /* Single column: the nav already carries the mark, so repeating it here
            said nothing the heading does not. */
        }
        <Block surface="base" layout="prose" class="text-center">
            <h1 class="text-4xl leading-tight font-extrabold md:text-5xl">Surge Synth Team</h1>
            <p class="mt-6">
                We are a group of musicians, developers, testers, documenters, and general volunteer
                open source enthusiasts who randomly assembled to work on the Surge Synthesizer. As
                the Surge project became more successful, and we kept having fun, we decided to
                branch out into other things too!
            </p>
            <p class="mt-4">
                Everything we make is free and open source. Come and build it with us.
            </p>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                <Button href="https://discord.gg/aFQDdMV" variant="solid">Join our Discord</Button>
                <Button href="https://github.com/surge-synthesizer">GitHub</Button>
            </div>
        </Block>

        {
            /*
             * One band per product, alternating surface rather than alternating
             * a hardcoded orange. The image side swaps every other row, which is
             * what the old grid did with flex-row-reverse.
             */
        }
        {
            projects.map((project, index) => {
                const href = project.data.url || `/${project.id}`;
                const flip = index % 2 === 1;

                return (
                    <Block surface={flip ? "raised" : "base"} layout="split">
                        <Cell class={flip ? "md:order-2" : ""}>
                            <a class="text-3xl font-bold" href={href}>
                                {project.data.title}
                            </a>
                            <p class="mt-3 max-w-prose">{project.data.summary}</p>
                            <p class="mt-4 text-xs font-bold tracking-[0.2em] uppercase opacity-70">
                                {project.data.categories.join(" · ")}
                            </p>
                        </Cell>

                        <Cell class={flip ? "md:order-1" : ""}>
                            <a href={href}>
                                <Image
                                    alt={project.data.title}
                                    src={project.data.cover}
                                    quality="100"
                                    format="png"
                                    class="product-image"
                                />
                            </a>
                        </Cell>
                    </Block>
                );
            })
        }
    </main>

    <SiteFooter variant="org" />
</Base>
