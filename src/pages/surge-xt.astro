<style>
    /* Theme-swapped artwork: the hero screenshot, which differs between the
       light and dark Surge skins in more than polarity, and the logo, whose
       blue and orange a CSS invert would turn into each other's opposites.

       The dark variant is the exception, so it is the one hidden by default - a
       reader on the default (system) setting with no data-theme attribute then
       still gets correct artwork. */
    .only-dark {
        display: none;
    }

    @media (prefers-color-scheme: dark) {
        :global(html:not([data-theme="light"])) .only-light {
            display: none;
        }

        :global(html:not([data-theme="light"])) .only-dark {
            display: block;
        }
    }

    :global(html[data-theme="dark"]) .only-light {
        display: none;
    }

    :global(html[data-theme="dark"]) .only-dark {
        display: block;
    }

    :global(html[data-theme="light"]) .only-light {
        display: block;
    }

    :global(html[data-theme="light"]) .only-dark {
        display: none;
    }
</style>
