---
import { getCollection, render } from "astro:content";
import Block from "../../components/Block.astro";
import Button from "../../components/Button.astro";
import NavHeader from "../../components/NavHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Base from "../../layouts/Base.astro";

/*
 * A product's released changelogs, newest first. Unreleased notes live at
 * changelog/nightly and are linked from here rather than mixed in.
 *
 * Deliberately no build activity: the nightly commit feed belongs on a nightlies
 * page alongside the builds themselves, as it does on the Surge site today.
 */
export async function getStaticPaths() {
    // Notes only: a product whose changelog/ folder is empty has no changelog
    // page, and therefore nothing for the nav to link to.
    const changelogs = await getCollection("changelogs");
    const slugs = new Set(changelogs.map((entry) => entry.data.product));

    return [...slugs].map((slug) => ({ params: { product: slug } }));
}

const { product } = Astro.params;

const projects = await getCollection("projects");
const title = projects.find((entry) => entry.id === product)?.data.title ?? product;

const entries = (await getCollection("changelogs"))
    .filter((entry) => entry.data.product === product)
    .sort((a, b) => b.data.order - a.data.order);

const released = entries.filter((entry) => !entry.data.nightly);
const hasNightlyNotes = entries.some((entry) => entry.data.nightly);

const rendered = await Promise.all(
    released.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<Base title={`${title} Changelog`} project={product}>
    <NavHeader slot="nav" currentProject={product} />

    <main>
        <Block surface="base" layout="prose">
            <h1 class="text-4xl font-extrabold">{title} changelog</h1>
            {
                hasNightlyNotes && (
                    <>
                        <p class="mt-4">Notes for the next release are written as it is built.</p>
                        <Button class="mt-6" href={`/${product}/changelog/nightly/`}>
                            Unreleased changes
                        </Button>
                    </>
                )
            }
            {
                released.length === 0 && !hasNightlyNotes && (
                    <p class="mt-4">No release notes have been written for {title} yet.</p>
                )
            }
        </Block>

        {
            rendered.map(({ entry, Content }, index) => (
                <Block surface={index % 2 === 0 ? "raised" : "base"} layout="prose">
                    <article class="!max-w-none !p-0">
                        <h2>{entry.data.title}</h2>
                        <Content />
                    </article>
                </Block>
            ))
        }
    </main>

    <SiteFooter />
</Base>
