---
import { getCollection, render } from "astro:content";
import NavHeader from "../components/NavHeader.astro";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

export async function getStaticPaths() {
    // Products own their own route: [project].astro renders the hero from the
    // project JSON and this collection's prose below it. Without this filter
    // both routes emit the same path and one silently wins.
    const productIds = new Set((await getCollection("projects")).map((p) => p.id));
    const pages = (await getCollection("pages")).filter((page) => !productIds.has(page.id));

    return pages.map((page) => ({
        params: { page: page.id },
        props: { page },
    }));
}

const { page } = Astro.props;
const url = page.data.url ?? (page.data.repo && `https://github.com/${page.data.repo}`);
const { Content } = await render(page);
---

<Base title={page.data.title}>
    <NavHeader slot="nav" />
    <article class="page-prose">
        <h1>{page.data.title}</h1>
        {
            url && (
                <a class="italic" href={url}>
                    {url}
                </a>
            )
        }
        <Content />
    </article>

    <SiteFooter variant="org" />
</Base>
