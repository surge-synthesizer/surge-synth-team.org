---
import { Image } from "astro:assets";
import scxt_build_nightly from "../content/generated/scxt-build-nightly.json" with { type: "json" };
import Block from "../components/Block.astro";
import Button from "../components/Button.astro";
import Cell from "../components/Cell.astro";
import ChangelogSection from "../components/ChangelogSection.astro";
import DownloadButton from "../components/DownloadButton.astro";
import FaqList from "../components/FaqList.astro";
import NavHeader from "../components/NavHeader.astro";
import ScxtCover from "../content/projects/screenshots/shortcircuit-xt.png";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

/*
 * Each highlight is its own Block rather than a cell in a feature grid: they
 * are due more copy, and an illustration apiece, at which point each becomes a
 * split band without anything here having to be rearranged.
 */
const highlights = [
    {
        title: "Sixteen parts",
        body: "A multi holds 16 parts, each an instrument with its own MIDI channel, macros and four FX. Play several instruments from one instance, or layer and split them.",
    },
    {
        title: "Zones, groups and variants",
        body: "Map samples across key and velocity, gather zones into groups with their own play mode and trigger conditions, and give a zone up to 16 variants for round robins.",
    },
    {
        title: "Processors per voice",
        body: "Every zone has four processor slots that run on each voice, and every group has four more on its mix: filters, distortion, EQ, delays, resonators and synth generators.",
    },
    {
        title: "Modulation",
        body: "Each voice runs its own envelopes, LFOs, step sequencers, phasors, randoms and envelope followers through a modulation matrix, alongside 16 macros per part.",
    },
    {
        title: "Opens your libraries",
        body: "Import SF2, SFZ, EXS, GIG, Akai AKP and .multisample instruments, and load WAV, FLAC, AIFF, MP3 and Opus samples.",
    },
    {
        title: "Mixer, MPE and tuning",
        body: "A 21 bus mixer with aux sends and 20 extra stereo outputs, MPE and CLAP note expressions, and microtuning through MTS-ESP or Scala files.",
    },
];

const faq = [
    {
        q: "Is Shortcircuit XT free?",
        a: "Yes. It is free and open source. The source is MIT licensed, and released binaries are distributed under the AGPL v3 or later.",
    },
    {
        q: "Is it finished?",
        a: "No. Shortcircuit XT is in beta, and the download on this page is a nightly build of the current code. Use a limiter while experimenting.",
    },
    {
        q: "Which systems and plugin formats are supported?",
        a: "Windows, macOS 10.15 or later, and Linux. Shortcircuit XT runs as a CLAP or VST3 plugin, as an Audio Unit on macOS, and as a standalone application.",
    },
    {
        q: "Can it load my sample libraries?",
        a: "It imports SF2, SFZ, EXS, GIG, Akai AKP and .multisample instruments, and loads WAV, FLAC, AIFF, MP3 and Opus samples. Features a format has that Shortcircuit XT cannot represent are skipped.",
    },
    {
        q: "Where are my patches kept?",
        a: "In <code>Documents/Surge Synth Team/Shortcircuit XT</code>, which also holds themes and presets. A whole instrument saves as a <code>.scm</code> multi and a single part as a <code>.scp</code>.",
    },
    {
        q: "Where do I get help or report a bug?",
        a: 'Ask in the <code>#using-shortcircuit</code> channel of the <a href="https://discord.com/invite/spGANHw">Surge Synth Team Discord</a>, and report bugs on the <a href="https://github.com/surge-synthesizer/shortcircuit-xt/issues">issue tracker</a>.',
    },
];
---

<Base title="Shortcircuit XT" project="shortcircuit-xt">
    <NavHeader slot="nav" currentProject="shortcircuit-xt" />

    <main>
        <Block surface="base" layout="split" class="md:min-h-[500px]">
            <Cell>
                <p class="text-xs font-bold tracking-[0.2em] uppercase opacity-70">
                    Open Source Sampling Workstation
                </p>
                <h1 class="mt-2 text-4xl leading-tight font-extrabold md:text-5xl">
                    Shortcircuit XT
                </h1>
                <p class="mt-4 max-w-prose">
                    Shortcircuit XT is a modern open source software sampler focused on workflow,
                    expressive modulation, and deep sample playback control.
                </p>
                <div class="mt-6 flex flex-wrap items-center gap-3">
                    <DownloadButton
                        windows={scxt_build_nightly.releases.win64}
                        mac={scxt_build_nightly.releases.macos}
                        linux={scxt_build_nightly.releases.linux64}
                        other={scxt_build_nightly.releases.other}
                        label="Download Nightly"
                        id="scxt-release-link"
                        buttonClass="button button-solid"
                    />
                    <Button href="https://github.com/surge-synthesizer/shortcircuit-xt">
                        View on GitHub
                    </Button>
                </div>
            </Cell>

            <Cell padded={false} class="min-h-[250px] md:min-h-0">
                <Image
                    src={ScxtCover}
                    alt="Shortcircuit XT interface screenshot"
                    quality="100"
                    format="png"
                    class="h-full max-h-[400px] w-full object-contain"
                />
            </Cell>
        </Block>

        {
            highlights.map((highlight, index) => (
                <Block surface={index % 2 === 0 ? "raised" : "base"} layout="prose">
                    <h2 class="text-2xl font-bold">{highlight.title}</h2>
                    <p class="mt-2 max-w-prose">{highlight.body}</p>
                </Block>
            ))
        }

        <Block id="manual" surface="accent" layout="prose">
            <h2 class="text-2xl font-bold">Manual</h2>
            <p class="mt-2 max-w-prose">
                The Shortcircuit XT manual covers the instrument structure, the editor, and every
                processor and modulation source.
            </p>
            <Button class="mt-6" href="/shortcircuit-xt/manual/">Open Manual</Button>
        </Block>

        <Block id="changelog" surface="base" layout="prose">
            <ChangelogSection productName="Shortcircuit XT" nightly={scxt_build_nightly} />
        </Block>

        <Block id="faq" surface="raised" layout="prose">
            <FaqList items={faq} />
        </Block>

        <Block id="about" surface="base" layout="prose">
            <h2 class="text-2xl font-bold">About</h2>
            <div class="mt-2 max-w-prose space-y-3">
                <p>
                    Shortcircuit XT is a rebuild of Shortcircuit 1 and 2, samplers released by
                    Vember Audio in the mid 2000s. Claes Johanson, who wrote the originals, gave the
                    Shortcircuit 2 source to the Surge Synth Team, and Shortcircuit XT keeps much of
                    that design and DSP while rewriting the rest in modern C++.
                </p>
                <p>
                    It is developed in the open by the Surge Synth Team, on
                    <a href="https://github.com/surge-synthesizer/shortcircuit-xt">GitHub</a> and in the
                    <code>#sc-development</code> channel of our
                    <a href="https://discord.com/invite/spGANHw">Discord</a>. The open source
                    projects it is built on are listed in the
                    <a href="/shortcircuit-xt/manual/credits/">manual's credits</a>.
                </p>
            </div>
        </Block>
    </main>

    <SiteFooter />
</Base>
