---
import { Image } from "astro:assets";
import scxt_build_nightly from "../content/generated/scxt-build-nightly.json" with { type: "json" };
import Block from "../components/Block.astro";
import Cell from "../components/Cell.astro";
import DownloadButton from "../components/DownloadButton.astro";
import DownloadMatrix from "../components/DownloadMatrix.astro";
import NavHeader from "../components/NavHeader.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import ScxtCover from "../content/products/shortcircuit-xt/images/shortcircuit-xt.png";
import scxt_logo from "../content/products/shortcircuit-xt/images/scxt-logo.svg";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

const highlights = [
    {
        title: "Sixteen parts",
        body: "A multi holds 16 parts, each an instrument with its own MIDI channel, macros and four FX. Play several instruments from one instance, or layer and split them.",
    },
    {
        title: "Zones, groups and variants",
        body: "Map samples across key and velocity, gather zones into groups with their own play mode and trigger conditions, and give a zone up to 16 variants for round robins.",
    },
    {
        title: "Processors per voice",
        body: "Every zone has four processor slots that run on each voice, and every group has four more on its mix: filters, distortion, EQ, delays, resonators and synth generators.",
    },
    {
        title: "Modulation",
        body: "Each voice runs its own envelopes, LFOs, step sequencers, phasors, randoms and envelope followers through a modulation matrix, alongside 16 macros per part.",
    },
    {
        title: "Opens your libraries",
        body: "Import SF2, SFZ, EXS, GIG, Akai AKP and .multisample instruments, and load WAV, FLAC, AIFF, MP3 and Opus samples.",
    },
    {
        title: "Mixer, MPE and tuning",
        body: "A 21 bus mixer with aux sends and 20 extra stereo outputs, MPE and CLAP note expressions, and microtuning through MTS-ESP or Scala files.",
    },
];

const systemRequirements = [
    {
        name: "Windows",
        items: [
            "Windows 10 or above, on an Intel or AMD processor featuring SSE4.2 instructions",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
    {
        name: "macOS",
        items: [
            "macOS 10.15 or above; Shortcircuit XT is an Intel/Apple Silicon universal binary",
            "8 GB RAM or above",
            "VST3, AU or CLAP compatible host application",
        ],
    },
    {
        name: "Linux",
        items: [
            "PC or ARM system running a Linux distribution",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
];

const platformLinks = (releases: { win64: string; macos: string; linux64: string }) => [
    { label: "Windows 64-bit", href: releases.win64 },
    { label: "macOS 64-bit", href: releases.macos },
    { label: "Linux 64-bit", href: releases.linux64 },
];
---

<Base title="Shortcircuit XT" project="shortcircuit-xt">
    <NavHeader slot="nav" currentProject="shortcircuit-xt" />

    <main>
        <Block surface="hero" layout="split" class="overflow-hidden">
            <Cell align="start">
                <h1>
                    <img
                        src={scxt_logo.src}
                        alt="Shortcircuit XT"
                        class="h-auto w-full max-w-[666px]"
                    />
                </h1>
                <p class="my-4 text-xl font-bold">Creative sample player and synthesis powerhouse.</p>
                <p class="max-w-prose">
                    A modern multi-timbral open source sampler focused on workflow,
                    expressive modulation, deep sample playback control, sprinkled with a myriad of
                    additional synthesis capabilities.
                </p>
                <p class="max-w-prose">
                    Shortcircuit XT is a spiritual successor of the beloved Vember Audio Shortcircuit sampler,
                    reimagined from the ground up.
                </p>
                <div class="flex flex-wrap items-center gap-3">
                    <DownloadButton
                        windows={scxt_build_nightly.releases.win64}
                        mac={scxt_build_nightly.releases.macos}
                        linux={scxt_build_nightly.releases.linux64}
                        other={scxt_build_nightly.releases.other}
                        id="scxt-release-link"
                        buttonClass="button button-solid"
                    />
                </div>
                <p class="mt-4">
                    <a href="/shortcircuit-xt/nightly">
                        Downloads for other platforms and installers
                    </a>
                </p>
                <p><a href="/shortcircuit-xt/manual/">Read the manual</a></p>
            </Cell>

            <Cell padded={false} class="py-8">
                <Image
                    src={ScxtCover}
                    alt="The Shortcircuit XT interface"
                    quality="100"
                    class="h-[165px] w-auto max-w-none self-center md:ml-[max(0px,50vw_-_783px)] md:h-[570px] md:self-start"
                />
            </Cell>
        </Block>

        {
            highlights.map((highlight, index) => (
                <Block surface={index % 2 === 0 ? "feature" : "feature-alt"} layout="prose">
                    <h2>{highlight.title}</h2>
                    <p class="max-w-prose">{highlight.body}</p>
                </Block>
            ))
        }

        <Block id="about" surface="raised" layout="prose">
            <h2>About</h2>
            <div class="mt-2 max-w-prose space-y-3">
                <p>
                    Shortcircuit XT is a rebuild of Shortcircuit 1 and 2, samplers released by
                    Vember Audio in the mid 2000s. Claes Johanson, who wrote the originals, gave the
                    Shortcircuit 2 source to the Surge Synth Team, and Shortcircuit XT keeps much of
                    that design and DSP while rewriting the rest in modern C++.
                </p>
            </div>
        </Block>

        <Block id="downloads" surface="blue" layout="split">
            <Cell align="start">
                <SystemRequirements platforms={systemRequirements} />
            </Cell>

            <Cell align="start">
                <DownloadMatrix
                    heading="Download Shortcircuit XT"
                    channels={[
                        {
                            label: "Nightly Builds",
                            links: platformLinks(scxt_build_nightly.releases),
                            all: {
                                label: "More info about nightly builds",
                                href: "/shortcircuit-xt/nightly",
                            },
                        },
                    ]}
                />
            </Cell>
        </Block>
    </main>

    <SiteFooter />
</Base>
