---
import { Image } from "astro:assets";
import spectrumworx_build_nightly from "../content/generated/spectrumworx-build-nightly.json" with { type: "json" };
import Block from "../components/Block.astro";
import Cell from "../components/Cell.astro";
import DownloadButton from "../components/DownloadButton.astro";
import DownloadMatrix from "../components/DownloadMatrix.astro";
import NavHeader from "../components/NavHeader.astro";
import SystemRequirements from "../components/SystemRequirements.astro";
import SpectrumWorxCover from "../content/products/spectrumworx/images/spectrumworx.png";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";
import spectrumworx_logo from "../content/products/spectrumworx/images/spectrumworx_logo_full.svg";

/*
 * Copy below the hero is still placeholder, carried over verbatim from the
 * pre-block page. Each highlight is its own Block, matching Shortcircuit XT, so
 * real copy and an illustration drop straight in.
 */
const highlights = [
    {
        title: "Feature Title 01",
        body: "Short description placeholder for a SpectrumWorx capability.",
    },
    {
        title: "Feature Title 02",
        body: "Short description placeholder for the modular effect chain.",
    },
    {
        title: "Feature Title 03",
        body: "Short description placeholder for sidechain and modulation.",
    },
];

/*
 * No SSE level on the list, unlike Shortcircuit XT: SpectrumWorx names no
 * -march at all, so it is whatever the baseline x86-64 of its compilers is.
 * macOS 10.15 is CMAKE_OSX_DEPLOYMENT_TARGET in its CMakeLists.
 */
const systemRequirements = [
    {
        name: "Windows",
        items: [
            "Windows 10 or above, 64-bit",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
    {
        name: "macOS",
        items: [
            "macOS 10.15 or above; SpectrumWorx is an Intel/Apple Silicon universal binary",
            "8 GB RAM or above",
            "VST3, AU or CLAP compatible host application",
        ],
    },
    {
        name: "Linux",
        items: [
            "64-bit PC running a Linux distribution",
            "8 GB RAM or above",
            "VST3 or CLAP compatible host application",
        ],
    },
];

const platformLinks = (releases: { win64: string; macos: string; linux64: string }) => [
    { label: "Windows 64-bit", href: releases.win64 },
    { label: "macOS 64-bit", href: releases.macos },
    { label: "Linux 64-bit", href: releases.linux64 },
];
---

<Base title="SpectrumWorx" project="spectrumworx">
    <NavHeader slot="nav" currentProject="spectrumworx" />

    <main>
        <Block surface="base" layout="split" class="overflow-hidden">
            <Cell>
                <h1>
                    <img
                        src={spectrumworx_logo.src}
                        alt="SpectrumWorx"
                        class="invert-in-light h-auto w-full max-w-[666px]"
                    />
                </h1>
                <p class="my-4 text-xl font-bold">Spectral Audio Effect</p>
                <p class="max-w-prose">
                    SpectrumWorx is a modular spectral effect: it decomposes your audio into the
                    frequency domain, lets you stack and chain effects on that spectrum, then
                    resynthesizes the result. Originally developed by Little Endian and open sourced
                    in 2024, it now runs as CLAP, VST3, and AU on Windows, macOS, and Linux.
                </p>
                <div class="flex flex-wrap items-center gap-3">
                    <DownloadButton
                        windows={spectrumworx_build_nightly.releases.win64}
                        mac={spectrumworx_build_nightly.releases.macos}
                        linux={spectrumworx_build_nightly.releases.linux64}
                        other={spectrumworx_build_nightly.releases.other}
                        id="spectrumworx-release-link"
                        buttonClass="button button-solid"
                    />
                </div>
                <p class="mt-4">
                    <a href="/spectrumworx/nightly">
                        Downloads for other platforms and installers
                    </a>
                </p>
                <p><a href="/spectrumworx/manual/">Read the manual</a></p>
                <p class="mt-4 text-xs opacity-80">
                    Source is GPL-3.0-or-later; released binaries link JUCE 8 under its AGPLv3 arm
                    and are therefore AGPL-3.0-or-later.
                </p>
            </Cell>

            {
                /* The same treatment as the OB-Xf hero: sized by height so nothing
                   crops it top or bottom, anchored left so only the far edge runs
                   past the column, and the band clips that.

                   The height is per product because it is the image's own ratio
                   that decides how wide it comes out - 2.04:1 here against
                   OB-Xf's 1.81 - and the aim is the same modest overhang on each.
                   Worth recomputing when this screenshot is replaced. */
            }
            <Cell padded={false} class="py-8">
                <Image
                    src={SpectrumWorxCover}
                    alt="The SpectrumWorx interface"
                    quality="100"
                    class="h-[220px] w-auto max-w-none self-center md:h-[max(540px,28vw)] md:self-start"
                />
            </Cell>
        </Block>

        {
            highlights.map((highlight, index) => (
                <Block
                    id={index === 0 ? "highlights" : undefined}
                    surface={index % 2 === 0 ? "raised" : "base"}
                    layout="prose">
                    <h2>{highlight.title}</h2>
                    <p class="max-w-prose">{highlight.body}</p>
                </Block>
            ))
        }

        {
            /* The band that closed the page as About, now carrying what it is
               worth closing on. One download channel, not Surge XT's two:
               SpectrumWorx has no stable release, so the nightly is the
               download rather than the bleeding edge beside one. */
        }
        <Block id="downloads" surface="base" layout="split">
            <Cell align="start">
                <SystemRequirements platforms={systemRequirements} />
            </Cell>

            <Cell align="start">
                <DownloadMatrix
                    heading="Download SpectrumWorx"
                    channels={[
                        {
                            label: "Nightly Builds",
                            links: platformLinks(spectrumworx_build_nightly.releases),
                            all: {
                                label: "More info about nightly builds",
                                href: "/spectrumworx/nightly",
                            },
                        },
                    ]}
                />
            </Cell>
        </Block>
    </main>

    <SiteFooter />
</Base>
