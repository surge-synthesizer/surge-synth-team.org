---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Block from "../components/Block.astro";
import Button from "../components/Button.astro";
import Cell from "../components/Cell.astro";
import NavHeader from "../components/NavHeader.astro";
import Base from "../layouts/Base.astro";
import SiteFooter from "../components/SiteFooter.astro";

/*
 * The long tail: every product without a hand-built page. It used to render a
 * title, a bare URL, a cover and one sentence, which is why eight products
 * looked unfinished next to the three that had pages of their own.
 *
 * Composed from the project's own JSON using core surfaces only, so a product
 * gains a real page the moment it has an entry, and gets a hand-built one later
 * by adding a route here - which then wins over this one, as OB-Xf,
 * Shortcircuit XT and SpectrumWorx already do.
 */

export async function getStaticPaths() {
    // Declared inside: Astro extracts getStaticPaths into its own module, so it
    // cannot close over anything in the frontmatter above.
    // Shrinks as each page moves to a page.mdx of its own.
    const handBuilt = ["ob-xf", "shortcircuit-xt", "spectrumworx", "surge-xt"];
    const projects = await getCollection("projects");
    const landings = await getCollection("productLanding");

    return projects
        .filter((project) => !handBuilt.includes(project.id))
        .map((project) => ({
            params: { project: project.id },
            props: { project, landing: landings.find((page) => page.id === project.id) },
        }));
}

const { project, landing } = Astro.props;

// A product that writes its own blocks renders them instead of the generated
// three; everything below is the fallback for one that has not.
const Landing = landing ? (await render(landing)).Content : null;

/*
 * Some products also have a prose page in the `pages` collection. Both routes
 * used to generate the same URL and one silently won, so that copy either
 * replaced the product page or was never seen. It now renders inside this one,
 * and [page].astro no longer claims product slugs.
 */
const pages = await getCollection("pages");
const prose = pages.find((entry) => entry.id === project.id);
const Prose = prose ? (await render(prose)).Content : null;
const { title, summary, cover, categories, repo, url, manual, issue_tracker } = project.data;

/*
 * "Download", like every other product's button says - so the destination has
 * to be one. A bare repo root is not, so a product with no `url` of its own is
 * sent to its latest release rather than its README.
 */
const homepage = url ?? (repo ? `https://github.com/${repo}/releases/latest` : undefined);

/*
 * The hand-built pages carry this under their download button, so the long
 * tail does too - but only where it leads somewhere the button does not. A
 * product with no `url` of its own already has the button pointing here.
 */
const releases = repo ? `https://github.com/${repo}/releases/latest` : undefined;
const otherDownloads = releases === homepage ? undefined : releases;

const links = [
    manual && { label: "Read the manual", href: manual },
    repo && { label: "Source on GitHub", href: `https://github.com/${repo}` },
    issue_tracker && { label: "Report an issue", href: issue_tracker },
].filter((link): link is { label: string; href: string } => Boolean(link));
---

<Base title={title} project={project.id}>
    <NavHeader slot="nav" currentProject={project.id} />

    <main>
        {
            Landing ? (
                <Landing />
            ) : (
                <>
                    <Block surface="base" layout="split" class="md:min-h-[460px]">
                        <Cell>
                            <h1 class="text-4xl leading-tight font-extrabold md:text-5xl">
                                {title}
                            </h1>
                            <p class="mt-2 text-xs font-bold tracking-[0.2em] uppercase opacity-70">
                                {categories.join(" · ")}
                            </p>
                            <p>{summary}</p>
                            {homepage && (
                                <div class="mt-6">
                                    <Button href={homepage} variant="solid">
                                        Download
                                    </Button>
                                </div>
                            )}

                            {otherDownloads && (
                                <p class="mt-4">
                                    <a href={otherDownloads}>
                                        Downloads for other platforms and installers
                                    </a>
                                </p>
                            )}
                        </Cell>

                        <Cell padded={false} class="min-h-[250px] md:min-h-0">
                            <Image
                                class="h-full max-h-[400px] w-full object-contain"
                                src={cover}
                                alt={`${title} interface screenshot`}
                                quality="100"
                                format="png"
                            />
                        </Cell>
                    </Block>

                    {Prose && (
                        <Block surface="raised" layout="prose">
                            <article class="!max-w-none !p-0">
                                <Prose />
                            </article>
                        </Block>
                    )}

                    {links.length > 0 && (
                        <Block surface={Prose ? "base" : "raised"} layout="prose">
                            <h2>Links</h2>
                            <ul>
                                {links.map((link) => (
                                    <li>
                                        <a href={link.href}>{link.label}</a>
                                    </li>
                                ))}
                            </ul>
                        </Block>
                    )}
                </>
            )
        }
    </main>

    <SiteFooter />
</Base>
